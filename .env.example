# Base da API REST (em dev passa pelo proxy do Vite)
API_BASE_URL=/api/v1
# Para onde o dev server repassa /api (o backend não envia CORS)
API_PROXY_TARGET=https://strategyanalytics.codebiz.com.br
# true = usa os dados de exemplo do protótipo (sem backend)
USE_MOCKS=false
# Google Analytics 4 (vazio desliga o gtag)
GA_MEASUREMENT_ID=
